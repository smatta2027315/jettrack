import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

export default function InstructorDashboard() {
  const navigate = useNavigate();

  const [user, setUser] = useState(null);
  const [pendingUsers, setPendingUsers] = useState([]);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(true);

  async function loadDashboard() {
    setError("");

    try {
      const [meResponse, pendingResponse] = await Promise.all([
        fetch("/api/auth/me", {
          credentials: "include",
        }),
        fetch("/api/auth/pending", {
          credentials: "include",
        }),
      ]);

      if (meResponse.status === 401 || meResponse.status === 403) {
        navigate("/login", { replace: true });
        return;
      }

      if (!meResponse.ok) {
        throw new Error("Unable to load your account.");
      }

      const meData = await meResponse.json();
      setUser(meData.user);

      if (!pendingResponse.ok) {
        throw new Error("Unable to load pending accounts.");
      }

      const pendingData = await pendingResponse.json();
      setPendingUsers(pendingData.users || []);
    } catch (err) {
      setError(err.message || "Unable to load dashboard.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadDashboard();
  }, []);

  async function approveAccount(userID, role) {
    setError("");

    try {
      const response = await fetch(
        `/api/auth/approve/${userID}`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          credentials: "include",
          body: JSON.stringify({ role }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.error || "Unable to approve account."
        );
      }

      // Refresh the pending-account list.
      await loadDashboard();
    } catch (err) {
      setError(err.message || "Approval failed.");
    }
  }

  async function handleLogout() {
    try {
      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "include",
      });
    } finally {
      navigate("/login", { replace: true });
    }
  }

  if (loading) {
    return <p>Loading Instructor Dashboard...</p>;
  }

  if (!user) {
    return (
      <main className="dashboard-content">
        <p>{error || "Unable to load Instructor Dashboard."}</p>
        <button onClick={handleLogout}>Return to Login</button>
      </main>
    );
  }

  return (
    <div className="dashboard">
      <aside className="sidebar">
        <h2>JET TRACK</h2>

        <p>Instructor Portal</p>

        <nav>
          <a href="#overview">Dashboard</a>
          <a href="#approvals">Account Approvals</a>
          <a href="#cadets">Manage Cadets</a>
          <a href="#fitness">Fitness Records</a>
          <a href="#events">Manage Events</a>
          <a href="#service">Service Hours</a>
          <a href="#awards">Awards and Promotions</a>
        </nav>

        <button onClick={handleLogout}>Log Out</button>
      </aside>

      <main className="dashboard-content">
        <header className="dashboard-header" id="overview">
          <div>
            <h1>Instructor Dashboard</h1>

            <p>
              Welcome back, {user.first_name}!
            </p>
          </div>

          <span className="role-badge">Instructor</span>
        </header>

        {error && (
          <p className="error-message" role="alert">
            {error}
          </p>
        )}

        <section className="dashboard-grid">
          <article className="dashboard-card" id="cadets">
            <h3>Manage Cadets</h3>
            <p>
              View and manage cadet profiles and records.
            </p>
          </article>

          <article className="dashboard-card" id="fitness">
            <h3>Fitness Records</h3>
            <p>Enter and update fitness assessment results.</p>
          </article>

          <article className="dashboard-card" id="events">
            <h3>Manage Events</h3>
            <p>Create and update unit events.</p>
          </article>

          <article className="dashboard-card" id="service">
            <h3>Service Hours</h3>
            <p>Review and maintain service-hour records.</p>
          </article>

          <article className="dashboard-card" id="awards">
            <h3>Awards and Promotions</h3>
            <p>Maintain awards and promotion records.</p>
          </article>
        </section>

        <section className="approval-section" id="approvals">
          <h2>Pending Account Approvals</h2>

          <p>
            Review new accounts and assign their JET TRACK roles.
          </p>

          {pendingUsers.length === 0 ? (
            <p>There are no pending accounts.</p>
          ) : (
            <div className="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Approve As</th>
                  </tr>
                </thead>

                <tbody>
                  {pendingUsers.map((pendingUser) => (
                    <tr key={pendingUser.userID}>
                      <td>
                        {pendingUser.first_name}{" "}
                        {pendingUser.last_name}
                      </td>

                      <td>{pendingUser.email}</td>

                      <td>
                        <button
                          onClick={() =>
                            approveAccount(
                              pendingUser.userID,
                              "Cadet"
                            )
                          }
                        >
                          Approve Cadet
                        </button>

                        <button
                          onClick={() =>
                            approveAccount(
                              pendingUser.userID,
                              "Cadet Leader"
                            )
                          }
                        >
                          Approve Leader
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </main>
    </div>
  );
}
