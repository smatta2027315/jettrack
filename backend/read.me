import {
  BrowserRouter,
  Routes,
  Route,
  Navigate,
} from "react-router-dom";

import Login from "./pages/Login";
import CadetDashboard from "./pages/CadetDashboard";
import CadetLeaderDashboard from "./pages/CadetLeaderDashboard";
import InstructorDashboard from "./pages/InstructorDashboard";

import ProtectedRoute from "./components/ProtectedRoute";

export default function App() {
  return (
    <BrowserRouter>
      <Routes>
        {/* Public login page */}
        <Route path="/login" element={<Login />} />

        {/* Cadet Dashboard */}
        <Route
          path="/cadet-dashboard"
          element={
            <ProtectedRoute allowedRoles={["Cadet"]}>
              <CadetDashboard />
            </ProtectedRoute>
          }
        />

        {/* Cadet Leader Dashboard */}
        <Route
          path="/cadet-leader-dashboard"
          element={
            <ProtectedRoute allowedRoles={["Cadet Leader"]}>
              <CadetLeaderDashboard />
            </ProtectedRoute>
          }
        />

        {/* Instructor Dashboard */}
        <Route
          path="/instructor-dashboard"
          element={
            <ProtectedRoute allowedRoles={["Instructor"]}>
              <InstructorDashboard />
            </ProtectedRoute>
          }
        />

        {/* Unknown URLs return to login */}
        <Route path="*" element={<Navigate to="/login" replace />} />
      </Routes>
    </BrowserRouter>
  );
}
